# ==============================================================================
# Paperwork Agent - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model Provider Configuration (Optional for offline demo/deterministic mode)
# ------------------------------------------------------------------------------
# Supported providers: openai, anthropic
MODEL_PROVIDER=openai
MODEL_ID=gpt-4o

# OpenAI Configuration (required if MODEL_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration (required if MODEL_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# MODEL_ID=claude-sonnet-4-6

# ------------------------------------------------------------------------------
# 2. OCR Provider Configuration
# ------------------------------------------------------------------------------
# Options:
#   - auto     : Uses AWS Textract if AWS credentials exist; otherwise uses local RapidOCR (default)
#   - local    : Enforces 100% offline RapidOCR with ONNX Runtime (zero network calls)
#   - textract : Enforces AWS Textract; raises explicit OCRProviderError if credentials/permissions fail
OCR_PROVIDER=auto

# Optional AWS Credentials (only needed if using OCR_PROVIDER=textract or auto with AWS)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_DEFAULT_REGION=us-east-1
# AWS_SESSION_TOKEN=your-optional-session-token

# ------------------------------------------------------------------------------
# 3. Storage & Directory Paths (Optional overrides)
# ------------------------------------------------------------------------------
# DOCUMENTS_DIR=backend/data/documents
# WORKFLOWS_DIR=backend/data/workflows

# ------------------------------------------------------------------------------
# 4. Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# Storage & Upload Configuration
# DOCUMENTS_DIR=data/documents
MAX_UPLOAD_SIZE_MB=10

